# API
APP_PORT=8080

# PostgreSQL
POSTGRES_USER=s3analysis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=analysis_db
POSTGRES_PORT=5432

# Garage
GARAGE_DEFAULT_ACCESS_KEY=CHANGE_ME
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME
GARAGE_DEFAULT_BUCKET=default-bucket

# Миграции PostgreSQL
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
GOOSE_MIGRATION_DIR=migrations
