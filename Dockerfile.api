# check=error=true

# Стадия 1: сборка
FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY services/api ./services/api
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o server ./services/api/cmd

# Стадия 2: финальный образ
FROM alpine:3.21
LABEL authors="ivananufriev"
RUN addgroup -S nonroot && adduser -S -G nonroot nonroot
COPY --from=builder /app/server /server
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/server"]
